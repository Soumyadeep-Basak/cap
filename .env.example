# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=invoice_auditor
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_DB_PASSWORD@postgres:5432/invoice_auditor

# Mock ERP
ERP_API_URL=http://mock-erp:8000

# Agent API
AGENT_API_URL=http://agent:8000

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=invoice_knowledge

AWS_REGION=us-east-1
BEDROCK_TRANSLATION_MODEL=amazon.nova-lite-v1:0
BEDROCK_DETECTION_MODEL=cohere.command-r-plus-v1:0

BEDROCK_LANGUAGE_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TRANSLATION_MODEL_ID=amazon.nova-lite-v1:0
